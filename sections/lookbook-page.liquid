
<section class="section-pad" style="padding:5rem 0;">
  <div class="container">
    <div style="text-align:center; max-width:680px; margin:0 auto 3rem;">
      <h1 style="font-size: clamp(3rem, 8vw, 4.5rem); margin-bottom:1rem;">Styled, not staged.</h1>
      <p style="font-size:1.1rem;">Nails as accessories — seen in gestures, outfits, and real life.</p>
    </div>
    <div class="lookbook-grid" style="display:grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap:1rem;">
      {% assign imgs = 'lifestyle-1.jpg,product-flatlay.jpg,lifestyle-2.jpg,collection-work.jpg,collection-everyday.jpg,collection-event.jpg' | split: ',' %}
      {% for img in imgs %}
        <div style="overflow:hidden; border-radius:1.25rem; background:white;">
          <img src="{{ img | strip | asset_url }}" alt="Lookbook {{ forloop.index }}" style="width:100%; height:100%; object-fit:cover; display:block;">
        </div>
      {% endfor %}
    </div>
    <div style="margin-top:3rem; text-align:center;">
      <p style="font-size:2rem; margin-bottom:0.5rem;">@chinchoo</p>
      <p style="margin-bottom:1rem;">Tag us to get featured</p>
      <a class="btn btn-primary" href="{{ settings.social_instagram }}">Share your look</a>
    </div>
  </div>
</section>
{% schema %}{"name":"Lookbook page","settings":[]}{% endschema %}
