<section class="hero-split" style="display: grid; grid-template-columns: 1fr 1fr; min-height: 80vh;">
  <div style="display: flex; flex-direction: column; justify-content: center; padding: 4rem 5rem;">
    <span style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.2em; color: hsl(var(--accent)); font-weight: 600; margin-bottom: 1rem;">
      {{ section.settings.tag | default: 'Always Put-Together' }}
    </span>
    <h1 style="font-family: var(--font-display); font-size: clamp(3rem, 5vw, 4.5rem); line-height: 1.05; margin-bottom: 1.5rem;">
      {{ section.settings.title | default: 'Feel like yourself, instantly.' }}
    </h1>
    <p style="font-size: 1.125rem; color: hsl(var(--fg) / 0.6); max-width: 28rem; margin-bottom: 2rem; line-height: 1.7;">
      {{ section.settings.subtext | default: 'The perfect fit without compromise. Chinchoo press-ons are designed to be your stylish friend in every journey.' }}
    </p>
    <div style="display: flex; gap: 1rem;">
      <a href="{{ section.settings.cta_url | default: '/collections/all' }}" class="btn btn-primary">
        {{ section.settings.cta_text | default: 'Shop Nails' }}
      </a>
      <a href="{{ section.settings.cta2_url | default: '/pages/how-it-works' }}" class="btn btn-outline">
        {{ section.settings.cta2_text | default: 'How It Works' }}
      </a>
    </div>
    
    <div style="margin-top: 3rem; display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; border-top: 1px solid hsl(var(--border)); padding-top: 2rem;">
      {% for block in section.blocks %}
        <div>
          <span style="display: block; font-weight: 700; font-size: 0.875rem;">{{ block.settings.label }}</span>
          <span style="font-size: 0.75rem; color: hsl(var(--fg) / 0.5);">{{ block.settings.sublabel }}</span>
        </div>
      {% endfor %}
    </div>
  </div>
  
  <div style="background: hsl(var(--secondary)); overflow: hidden;">
    {% if section.settings.image %}
      {{ section.settings.image | image_url: width: 1200 | image_tag: class: 'hero-image', style: 'width:100%;height:100%;object-fit:cover;' }}
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Hero Split",
  "settings": [
    { "type": "text", "id": "tag", "label": "Tag line", "default": "Always Put-Together" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Feel like yourself, instantly." },
    { "type": "textarea", "id": "subtext", "label": "Subtext" },
    { "type": "image_picker", "id": "image", "label": "Hero Image" },
    { "type": "text", "id": "cta_text", "label": "Primary CTA text", "default": "Shop Nails" },
    { "type": "url", "id": "cta_url", "label": "Primary CTA link" },
    { "type": "text", "id": "cta2_text", "label": "Secondary CTA text", "default": "How It Works" },
    { "type": "url", "id": "cta2_url", "label": "Secondary CTA link" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "30 Nails" },
        { "type": "text", "id": "sublabel", "label": "Sublabel", "default": "Perfect fit for every finger" }
      ]
    }
  ],
  "presets": [{ "name": "Hero Split" }]
}
{% endschema %}
