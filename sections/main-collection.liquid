
<section class="section-pad" style="padding: 4rem 0;">
  <div class="container">
    <div style="max-width: 42rem; margin-bottom: 2rem;">
      <h1 style="font-size: 3rem; margin-bottom: 0.75rem;">{{ collection.title }}</h1>
      {% if collection.description != blank %}<div class="rte">{{ collection.description }}</div>{% endif %}
    </div>
    {% paginate collection.products by 12 %}
      <div class="featured-grid" style="display:grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.5rem;">
        {% for product in collection.products %}
          {% render 'product-card', product: product %}
        {% else %}
          <p>{{ 'collections.general.no_matches' | t }}</p>
        {% endfor %}
      </div>
      {% if paginate.pages > 1 %}
        <div style="display:flex; justify-content:center; gap:0.75rem; margin-top:2rem;">
          {% if paginate.previous %}<a class="btn btn-outline" href="{{ paginate.previous.url }}">Previous</a>{% endif %}
          {% if paginate.next %}<a class="btn btn-primary" href="{{ paginate.next.url }}">Next</a>{% endif %}
        </div>
      {% endif %}
    {% endpaginate %}
  </div>
</section>

{% schema %}
{ "name": "Main collection", "settings": [] }
{% endschema %}
