
<header class="site-header" style="position: sticky; top: 0; z-index: 50; background: hsl(var(--bg) / 0.95); backdrop-filter: blur(12px); border-bottom: 1px solid hsl(var(--border));">
  <div class="container" style="display: flex; align-items: center; justify-content: space-between; height: 4.25rem; gap: 1rem;">
    <a href="{{ routes.root_url }}" class="logo-chinchoo" style="text-decoration: none; display:flex; align-items:center;">
      {% if settings.logo %}
        <img src="{{ settings.logo | image_url: width: settings.logo_width }}" alt="{{ shop.name }}" style="height: 28px; width: auto;">
      {% else %}
        <img src="{{ 'logo-purple.svg' | asset_url }}" alt="{{ shop.name }}" style="height: 28px; width: auto;">
      {% endif %}
    </a>

    <nav class="main-nav" style="display: flex; gap: 2rem; align-items:center;">
      {% assign main_menu = linklists[section.settings.menu] %}
      {% if main_menu.links.size > 0 %}
        {% for link in main_menu.links %}
          <a href="{{ link.url }}" style="font-size: 0.95rem; font-weight: 600; text-decoration: none; color: hsl(var(--accent-bubblegum) / 0.85); transition: color 0.2s;">
            {{ link.title }}
          </a>
        {% endfor %}
      {% else %}
        <a href="{{ routes.collections_url }}/all" style="font-size: 0.95rem; font-weight: 600; text-decoration: none; color: hsl(var(--accent-bubblegum) / 0.85);">Shop</a>
        <a href="{{ routes.collections_url }}" style="font-size: 0.95rem; font-weight: 600; text-decoration: none; color: hsl(var(--accent-bubblegum) / 0.85);">Collections</a>
        <a href="/pages/how-it-works" style="font-size: 0.95rem; font-weight: 600; text-decoration: none; color: hsl(var(--accent-bubblegum) / 0.85);">How It Works</a>
        <a href="/pages/brand-story" style="font-size: 0.95rem; font-weight: 600; text-decoration: none; color: hsl(var(--accent-bubblegum) / 0.85);">Brand Story</a>
        <a href="/pages/lookbook" style="font-size: 0.95rem; font-weight: 600; text-decoration: none; color: hsl(var(--accent-bubblegum) / 0.85);">Lookbook</a>
        <a href="/pages/faq" style="font-size: 0.95rem; font-weight: 600; text-decoration: none; color: hsl(var(--accent-bubblegum) / 0.85);">FAQ</a>
      {% endif %}
    </nav>

    <div style="display: flex; align-items: center; gap: 1rem;">
      <a href="{{ routes.cart_url }}" style="position: relative; color: hsl(var(--accent)); text-decoration: none;">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
        <span style="position: absolute; top: -6px; right: -6px; background: hsl(var(--accent)); color: hsl(var(--butter)); font-size: 10px; font-weight: 700; width: 16px; height: 16px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
          {{ cart.item_count }}
        </span>
      </a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Navigation menu",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
