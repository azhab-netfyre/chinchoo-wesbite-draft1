<section style="padding: 6rem 0;">
  <div class="container">
    <div style="max-width: 42rem; margin: 0 auto 4rem; text-align: center;">
      <h2 style="font-size: 2.5rem; margin-bottom: 1rem;">{{ section.settings.title | default: 'The Chinchoo Count' }}</h2>
      <p>{{ section.settings.subtitle | default: "Most brands give you 24 nails. We give you 30. Why? Because \"close enough\" isn't a fit." }}</p>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; max-width: 56rem; margin: 0 auto;">
      <div style="background: hsl(var(--secondary)); padding: 2.5rem; border-radius: var(--radius-card);">
        <h3 style="font-size: 1.25rem; margin-bottom: 1.5rem;">Standard Brands</h3>
        <div style="display: flex; flex-wrap: wrap; gap: 0.375rem; opacity: 0.3;">
          {% for i in (1..24) %}
            <div class="nail-dot" style="border-color: hsl(var(--fg));"></div>
          {% endfor %}
        </div>
        <p style="margin-top: 1.5rem; font-size: 0.875rem; opacity: 0.6;">Often missing the exact size for your thumb or pinky.</p>
      </div>

      <div style="background: hsl(var(--accent)); color: hsl(var(--butter)); padding: 2.5rem; border-radius: var(--radius-card); box-shadow: 0 12px 40px -8px hsl(var(--accent) / 0.3); transform: scale(1.02);">
        <h3 style="font-size: 1.25rem; margin-bottom: 1.5rem; color: hsl(var(--butter));">The Chinchoo Fit</h3>
        <div style="display: flex; flex-wrap: wrap; gap: 0.375rem;">
          {% for i in (1..30) %}
            <div class="nail-dot" style="border-color: hsl(var(--butter)); background: hsla(60,100%,93%,0.2);"></div>
          {% endfor %}
        </div>
        <p style="margin-top: 1.5rem; font-size: 0.875rem; font-weight: 700; color: hsl(var(--butter));">30 Nails. 15 Sizes. Guaranteed fit for both hands.</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "30-Nail Comparison",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "The Chinchoo Count" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle" }
  ],
  "presets": [{ "name": "30-Nail Comparison" }]
}
{% endschema %}
