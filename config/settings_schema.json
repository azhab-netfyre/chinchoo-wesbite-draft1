      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo width",
        "min": 60,
        "max": 300,
        "step": 10,
        "default": 140,
        "unit": "px"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Background (Soft Butter)",
        "default": "#FFFFD9"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text color",
        "default": "#1F1F1F"
      },
      {
        "type": "color",
        "id": "color_primary",
        "label": "Heading color (Cherry Punch)",
        "default": "#EB355B"
      },
      {
        "type": "color",
        "id": "color_bubblegum",
        "label": "Bubblegum (Logo / paragraphs)",
        "default": "#FF76E5"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent (Electric Purple)",
        "default": "#8147FE"
      },
      {
        "type": "color",
        "id": "color_mint",
        "label": "Mint Pop",
        "default": "#75F9B0"
      },
      {
        "type": "color",
        "id": "color_lemon",
        "label": "Lemon Glow",
        "default": "#FFFFA1"
      },
      {
        "type": "checkbox",
        "id": "enable_logo_shimmer",
        "label": "Enable logo hover glow",
        "default": true
      }
    ]
  },
  {
    "name": "Trust & Shipping",
    "settings": [
      {
        "type": "text",
        "id": "trust_shipping",
        "label": "Shipping note",
        "default": "Ships from India \u00b7 India-wide coverage"
      },
      {
        "type": "text",
        "id": "trust_guarantee",
        "label": "Guarantee note",
        "default": "90-day quality coverage"
      },
      {
        "type": "text",
        "id": "trust_cod",
        "label": "COD/Payment note",
        "default": "COD available on select orders"
      },
      {
        "type": "text",
        "id": "free_shipping_threshold",
        "label": "Free shipping threshold",
        "default": "\u20b9999"
