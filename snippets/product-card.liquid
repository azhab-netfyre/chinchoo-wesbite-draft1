<a href="{{ product.url }}" class="product-card" style="display: block; text-decoration: none; color: inherit;">
  <div style="position: relative; aspect-ratio: 1/1; overflow: hidden; border-radius: 1rem; background: hsl(var(--secondary));">
    {% if product.featured_image %}
      <img
        src="{{ product.featured_image | image_url: width: 600 }}"
        alt="{{ product.featured_image.alt | default: product.title }}"
        loading="lazy"
        style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease;"
      >
    {% endif %}
    {% if product.available == false %}
      <span class="badge" style="position: absolute; top: 0.75rem; left: 0.75rem; background: hsl(var(--fg)); color: hsl(var(--butter));">Sold Out</span>
    {% elsif product.compare_at_price > product.price %}
      <span class="badge badge-new" style="position: absolute; top: 0.75rem; left: 0.75rem;">Sale</span>
    {% endif %}
  </div>
  <div style="margin-top: 1rem;">
    <h3 style="font-weight: 700; font-size: 1rem;">{{ product.title }}</h3>
    <p style="font-size: 0.875rem; margin-top: 0.25rem;">{{ product.metafields.custom.short_description | default: product.description | strip_html | truncate: 60 }}</p>
    <p style="margin-top: 0.5rem; font-weight: 700; color: hsl(var(--accent));">{{ product.price | money }}</p>
  </div>
</a>
