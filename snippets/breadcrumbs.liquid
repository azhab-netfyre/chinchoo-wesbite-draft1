<nav style="font-size: 0.875rem; color: hsl(var(--fg) / 0.5); margin-bottom: 1rem;">
  <a href="/" style="color: inherit; text-decoration: none;">Home</a>
  <span style="margin: 0 0.5rem;">/</span>
  {% if collection %}
    <a href="{{ collection.url }}" style="color: inherit; text-decoration: none;">{{ collection.title }}</a>
    <span style="margin: 0 0.5rem;">/</span>
  {% elsif template contains 'product' %}
    <a href="/collections/all" style="color: inherit; text-decoration: none;">Shop</a>
    <span style="margin: 0 0.5rem;">/</span>
  {% endif %}
  <span style="color: hsl(var(--fg));">{{ product.title | default: page_title }}</span>
</nav>
